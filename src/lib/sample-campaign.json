        }
      ],
      "actions": [
        {
          "name": "Multiattack",
          "description": "The Warden makes two Soul Blade attacks."
        },
        {
          "name": "Soul Blade",
          "description": "Melee Weapon Attack: +6 to hit, reach 5 ft., one target. Hit: 10 (2d6 + 3) slashing damage plus 7 (2d6) necrotic damage."
        }
      ],
      "reactions": [
        {
          "name": "Grasp of the Lost",
          "description": "When a creature within 10 ft. of the Warden moves, the Warden forces a DC 14 Strength save. On a failure, the creature's speed is 0 until the end of its turn."
        }
      ],
      "legendaryActions": [
        {
          "name": "Legendary Actions",
          "description": "The Warden can take 3 legendary actions, choosing from the options below. Only one legendary action can be used at a time and only at the end of another creature's turn. The Warden regains spent legendary actions at the start of its turn."
        },
        {
          "name": "Step Through Shadow",
          "description": "The Warden teleports up to 20 ft. to an unoccupied space it can see in dim light or darkness."
        },
        {
          "name": "Soul Blade (Costs 2 Actions)",
          "description": "The Warden makes one Soul Blade attack."
        }
      ],
      "lairActions": [
        {
          "name": "Wailing Dead",
          "description": "On initiative count 20, the bound souls wail. Each creature in the crypt makes a DC 13 Wisdom save or is frightened of the Warden until initiative count 20 on the next round."
        }
      ],
      "notes": "Original sample boss — shows off legendary and lair actions in the combat tracker."
    }
